# Supabase — valores públicos del proyecto (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opcional: project ref para documentación / scripts locales
# SUPABASE_PROJECT_REF=your-project-ref

# Solo para Edge Functions (NO embebidas en la app).
# Configurarlas en Supabase Dashboard → Edge Functions → Secrets:
# EXPO_ACCESS_TOKEN=...
# SUPABASE_SERVICE_ROLE_KEY se inyecta automáticamente en Edge Functions de Supabase.
# Nunca agregues service_role, Apple credentials, .p8 ni Expo tokens a este repo.
