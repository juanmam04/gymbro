# Supabase — valores públicos del proyecto (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Scanner / food search (client flags — NOT secrets)
EXPO_PUBLIC_NUTRITION_SCAN_PROVIDER=real
EXPO_PUBLIC_FOOD_SEARCH_PROVIDER=real

# Local / CLI only (never EXPO_PUBLIC_*)
SUPABASE_PROJECT_REF=your-project-ref
DATABASE_URL=postgresql://postgres.your-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_ACCESS_TOKEN=
OPENAI_API_KEY=
VISION_MODEL=gpt-4o
EXPO_ACCESS_TOKEN=

# Edge Function secrets are set in Supabase Dashboard, not in the mobile bundle.
# Never commit real service_role, Apple credentials, or private API keys.

# RevenueCat PUBLIC app-specific SDK keys (never the secret server key)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server-only Supabase secrets
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
ALLOW_SANDBOX_BILLING=false
